# Copia este archivo como .env.local (en tu compu) o pon estas variables en tu hosting.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Llave secreta: SOLO en el servidor. Se usa para la API de comisiones, los avisos y las invitaciones.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Nombre en el login y en el ícono instalado (dentro de la app se usa el de Configuración) ---
NEXT_PUBLIC_APP_NAME=Dulces de Mamá
# Dirección pública de la app (para los enlaces de los correos). Ej. https://postres.tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integración con el sistema de comisiones ---
# Llave que tu sistema manda en "Authorization: Bearer <llave>". Genera una larga y aleatoria.
COMMISSIONS_API_KEY=
# Dónde recibe tu sistema el aviso "invoice.paid".
COMMISSIONS_WEBHOOK_URL=
# Con esta llave se firman los avisos (header X-Signature: sha256=<hmac>). Tu sistema la usa para verificarlos.
COMMISSIONS_WEBHOOK_SECRET=
# Protege /api/cron/webhooks (reintentos de avisos). Un cron externo lo llama con "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
